# Free Models Rating — safe configuration template
# Copy to a local ignored .env file or enter these names in Portainer.
# Never put real values in this file, GitHub, Docker Compose, or documentation.

# Image deployment
FREE_MODELS_IMAGE=ghcr.io/OWNER/REPOSITORY
IMAGE_TAG=main
CONTAINER_NAME=free_models
HOST_PORT=8765
PROXY_NETWORK_NAME=YOUR_EXISTING_DOCKER_NETWORK

# Application runtime
PORT=3000
NODE_ENV=production
DATABASE_URL=file:/app/server/prisma/dev.db
ENCRYPTION_KEY=<64-hex-characters>

# Optional provider credentials
OPENROUTER_API_KEY=<optional>
GROQ_API_KEY=<optional>
GEMINI_API_KEY=<optional>
DEEPSEEK_API_KEY=<optional>
HUGGINGFACE_API_KEY=<optional>
NVIDIA_NIM_API_KEY=<optional>
KIMI_API_KEY=<optional>
MINIMAX_API_KEY=<optional>
OPENCODE_API_KEY=<optional>
CLOUDFLARE_API_TOKEN=<optional>
ZAI_API_KEY=<optional>
OLLAMA_API_KEY=<optional>
